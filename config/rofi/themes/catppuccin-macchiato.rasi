/* ── Catppuccin Macchiato ── minimal modern ── */
* {
    bg:           #24273a;
    bg-alt:       #181926;
    bg-hover:     #363a4f;
    fg:           #cad3f5;
    fg-alt:       #a5adcb;
    accent:       #c6a0f6;
    accent2:      #8aadf4;
    red:          #ed8796;
    green:        #a6da95;
    yellow:       #eed49f;
    blue:         #8aadf4;
    mauve:        #c6a0f6;
    pink:         #f5bde6;
    teal:         #8bd5ca;
    border:       #c6a0f6;
    selected:     #363a4f;
    urgent:       #ed8796;
    transparent:  #00000000;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 32em;
    border: 1px solid;
    border-color: @border;
    border-radius: 14px;
    background-color: @bg;
}

mainbox {
    background-color: @bg;
    padding: 14px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry, case-indicator ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search…";
    placeholder-color: @fg-alt;
}

case-indicator {
    enabled: false;
}

message {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 10px 14px;
    margin: 10px 0px 0px 0px;
    children: [ textbox ];
}
textbox {
    background-color: transparent;
    text-color: @fg;
}

listview {
    background-color: transparent;
    padding: 10px 0px 0px 0px;
    margin: 0px;
    lines: 8;
    columns: 1;
    scrollbar: false;
    spacing: 2px;
    cycle: true;
    fixed-height: false;
}

element {
    background-color: transparent;
    padding: 8px 10px;
    border-radius: 8px;
    spacing: 10px;
    cursor: pointer;
}
element selected {
    background-color: @accent;
}

element-icon {
    background-color: transparent;
    size: 18px;
    cursor: inherit;
}
element-icon selected {
    background-color: transparent;
    text-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: @fg;
    cursor: inherit;
    vertical-align: 0.5;
}
element-text selected {
    background-color: transparent;
    text-color: @bg;
}

scrollbar {
    handle-color: @selected;
    handle-width: 4px;
    border-radius: 4px;
    background-color: transparent;
}

sidebar {
    background-color: transparent;
    border: 1px 0px 0px 0px solid;
    border-color: @bg-alt;
    padding: 10px 0px 0px 0px;
    margin: 10px 0px 0px 0px;
}

button {
    padding: 6px 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg-alt;
}
button selected {
    background-color: @bg-alt;
    text-color: @accent;
}
