// Monitor manager menu -- minimal modern, synced via shared.rasi
// (regenerated by apply-theme-colors.sh on every theme switch).

configuration {
    show-icons: false;
}

@import "shared.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 40%;
    border: 1px solid;
    border-color: @accent;
    border-radius: 14px;
    background-color: @background;
}

mainbox {
    background-color: @background;
    padding: 14px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @background-alt;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry, case-indicator ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search…";
    placeholder-color: @foreground-alt;
}

case-indicator {
    enabled: false;
}

message {
    background-color: @background-alt;
    border-radius: 10px;
    padding: 10px 14px;
    margin: 10px 0px 0px 0px;
    children: [ textbox ];
}
textbox {
    background-color: transparent;
    text-color: @foreground;
}

listview {
    background-color: transparent;
    padding: 10px 0px 0px 0px;
    margin: 0px;
    lines: 6;
    columns: 1;
    scrollbar: false;
    spacing: 10px;
    cycle: true;
    fixed-height: false;
    dynamic: true;
}

element {
    background-color: @background-alt;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid;
    border-color: @background-alt;
    spacing: 4px;
    cursor: pointer;
}
element selected {
    background-color: @background-alt;
    border-color: @accent;
}

element-icon {
    background-color: transparent;
    size: 18px;
    cursor: inherit;
}
element-icon selected {
    background-color: transparent;
    text-color: @accent;
}

element-text {
    background-color: transparent;
    text-color: @foreground;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}
element-text selected {
    background-color: transparent;
    text-color: @foreground;
}

scrollbar {
    handle-color: @selected;
    handle-width: 4px;
    border-radius: 4px;
    background-color: transparent;
}
