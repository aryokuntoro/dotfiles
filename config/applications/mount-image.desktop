[Desktop Entry]
Name=Mount Disk Image
Comment=Mount an ISO/IMG/UDF disk image and open it in Thunar
Exec=/home/kiddo/.config/Thunar/scripts/mount-image.sh %F
Terminal=false
Type=Application
Icon=media-optical
Categories=System;
MimeType=application/x-iso9660-image;application/x-cd-image;application/x-raw-disk-image;application/vnd.efi.iso;
