# ═══════════════════════════════════════════════════════════════
#  i3wm Rice Configuration
#  No i3-sensible, dmenu, i3-status
# ═══════════════════════════════════════════════════════════════

# ── Variables ──────────────────────────────────────────────────
set $mod Mod4
set $terminal kitty
set $browser firefox
set $filemgr thunar
set $mediaplayer mpv
set $screenshot ~/.config/i3/scripts/screenshot.sh
set $record ~/.config/i3/scripts/recordrofi.sh
set $stream ~/.config/i3/scripts/streamrofi.sh
set $theme ~/.config/i3/scripts/theme-switch.sh

# ── Font ───────────────────────────────────────────────────────
font pango:JetBrainsMono Nerd Font 10

# ── Autostart ──────────────────────────────────────────────────
exec_always --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY && dbus-update-activation-environment --systemd DISPLAY XAUTHORITY
exec_always --no-startup-id ~/.config/autostart/autostart.sh
exec_always --no-startup-id feh --bg-scale ~/Pictures/Wallpapers/wallpaper.jpg
exec --no-startup-id ~/.config/i3/scripts/init-workspaces.sh

# ── Gap & Borders ─────────────────────────────────────────────
gaps inner 8
gaps outer 4
smart_gaps on
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# ── Color Scheme (set by theme-switch.sh from the active rofi theme) ──
# COLORS-START
set $bg         #303446
set $bg-alt     #292c3c
set $bg-hover   #414559
set $bg-urgent  #e78284
set $fg         #c6d0f5
set $fg-alt     #b5bfe2
set $fg-urgent  #303446
set $accent     #ca9ee6
set $accent2    #8caaee
set $red        #e78284
set $green      #a6d189
set $yellow     #e5c890
set $blue       #8caaee
set $purple     #ca9ee6
set $aqua       #81c8be
set $orange     #8caaee
# COLORS-END

# ── Window Class Rules ─────────────────────────────────────────
for_window [class=".*"]                     border pixel 2
for_window [class="feh"]                    floating enable
for_window [class="pavucontrol"]            floating enable
for_window [class="Arandr"]                 floating enable
for_window [class="Lxappearance"]           floating enable
for_window [class="Thunar"]                 floating enable
for_window [class="Rofi"]                   floating enable
for_window [class="Xarchiver"]                   floating enable
for_window [title="ffmpeg - recording"]     floating enable, move position center
for_window [instance="scratchpad"]          move scratchpad, resize set 900 600
for_window [window_role="pop-up"]           floating enable
for_window [window_role="task_dialog"]      floating enable
for_window [window_type="dialog"]           floating enable, move position center
for_window [urgent=latest]                  focus

# ── Keybindings: Core ─────────────────────────────────────────
bindsym $mod+Return       exec $terminal
bindsym $mod+Shift+q      kill
bindsym $mod+d            exec ~/.config/i3/scripts/rofi-mode.sh drun -show-icons
bindsym $mod+Tab          exec ~/.config/i3/scripts/rofi-mode.sh window -show-icons
bindsym $mod+Shift+d      exec ~/.config/i3/scripts/rofi-mode.sh run
bindsym $mod+p       exec ~/.config/rofi/scripts/powermenu.sh

# ── Keybindings: Applications ──────────────────────────────────
bindsym $mod+Shift+b      exec $browser
bindsym $mod+e            exec $filemgr
bindsym $mod+m            exec $mediaplayer
bindsym $mod+x            exec betterlockscreen -l dim

# ── Keybindings: Rofi Modis ───────────────────────────────────
bindsym $mod+c            exec rofi -show calc -theme ~/.config/rofi/themes/current.rasi
bindsym $mod+period       exec rofi -show emoji -theme ~/.config/rofi/themes/current.rasi
bindsym $mod+n            exec ~/.config/rofi/scripts/rofi-network.sh
bindsym $mod+b            exec ~/.config/rofi/scripts/rofi-bluetooth.sh
bindsym $mod+Shift+v      exec rofi -modi "clipboard:greenclip print" -show clipboard -theme ~/.config/rofi/themes/current.rasi
bindsym $mod+F1           exec $screenshot
bindsym $mod+Ctrl+r       exec $record
bindsym $mod+Shift+s      exec $stream
bindsym $mod+F2           exec $theme
bindsym $mod+F3           exec ~/.config/i3/scripts/wallpaper.sh
bindsym $mod+F4           exec ~/.config/i3/scripts/colorreload.sh
bindsym $mod+F5           exec ~/.config/rofi/scripts/rofi-monitor.sh
bindsym $mod+Shift+y      exec ~/.config/rofi/scripts/rofi-ytdlp.sh

# ── Keybindings: Media ─────────────────────────────────────────
bindsym XF86AudioPlay       exec playerctl play-pause
bindsym XF86AudioNext      exec playerctl next
bindsym XF86AudioPrev      exec playerctl previous
bindsym XF86AudioStop      exec playerctl stop
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute      exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# ── Keybindings: Navigation ────────────────────────────────────
bindsym $mod+h            focus left
bindsym $mod+j            focus down
bindsym $mod+k            focus up
bindsym $mod+l            focus right
bindsym $mod+Left         focus left
bindsym $mod+Down         focus down
bindsym $mod+Up           focus up
bindsym $mod+Right        focus right

# ── Keybindings: Move Window ──────────────────────────────────
bindsym $mod+Shift+h      move left
bindsym $mod+Shift+j      move down
bindsym $mod+Shift+k      move up
bindsym $mod+Shift+l      move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

# ── Keybindings: Split & Layout ───────────────────────────────
bindsym $mod+slash        split h
bindsym $mod+minus        split v
bindsym $mod+f            fullscreen toggle
bindsym $mod+g            layout toggle split
bindsym $mod+w            layout tabbed
bindsym $mod+s            layout toggle split
bindsym $mod+a            focus parent
bindsym $mod+Shift+space  floating toggle
bindsym $mod+space        focus mode_toggle

# ── Keybindings: Resize Mode ───────────────────────────────────
bindsym $mod+r            mode "resize"
mode "resize" {
    bindsym h resize shrink width  5 px or 5 ppt
    bindsym j resize grow   height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow   width  5 px or 5 ppt
    bindsym Left  resize shrink width  5 px or 5 ppt
    bindsym Down  resize grow   height 5 px or 5 ppt
    bindsym Up    resize shrink height 5 px or 5 ppt
    bindsym Right resize grow   width  5 px or 5 ppt
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# ── Keybindings: Workspaces ───────────────────────────────────
set $ws1  "1:"
set $ws2  "2:"
set $ws3  "3:"
set $ws4  "4:"
set $ws5  "5:"
set $ws6  "6:"
set $ws7  "7:"
set $ws8  "8:"
set $ws9  "9:"
set $ws10 "10:"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# ── Workspace Assignments ──────────────────────────────────────
assign [class="Firefox"]              → $ws2
assign [class="Thunar"]              → $ws3
assign [class="Code"]                → $ws4
assign [class="mpv"]                  → $ws5
assign [class="TelegramDesktop"]     → $ws6
assign [class="Zathura"]              → $ws7
assign [class="Steam"]                → $ws8
assign [class="Gimp"]                 → $ws9

# ── Multi-monitor ─────────────────────────────────────────────
workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output primary
workspace $ws5 output primary
workspace $ws6 output HDMI-0
workspace $ws7 output HDMI-0
workspace $ws8 output HDMI-0
workspace $ws9 output HDMI-0
workspace $ws10 output HDMI-0

# ── Scratchpad ─────────────────────────────────────────────────
bindsym $mod+Shift+Return exec $terminal --class scratchpad -e tmux
bindsym $mod+Ctrl+Return  scratchpad show

# ── Reload & Restart ───────────────────────────────────────────
bindsym $mod+Shift+c      reload
bindsym $mod+Shift+r      restart

# ── Colors (dynamic via pywal) ─────────────────────────────────
# class border      backgr.     text        indicator   child_border
client.focused          $accent     $accent     $fg         $accent2    $accent
client.focused_inactive $bg $bg         $fg         $bg         $bg
client.unfocused        $bg         $bg         $fg-urgent  $bg         $bg
client.urgent           $fg-urgent  $fg-urgent  $fg         $fg-urgent  $fg-urgent
client.placeholder      $bg         $bg         $fg         $bg         $bg
client.background       $bg

# ── Bar (Polybar handled separately) ───────────────────────────
# No i3bar - using polybar instead

# ── Floating modifier ──────────────────────────────────────────
floating_modifier $mod

