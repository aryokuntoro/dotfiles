#!/usr/bin/env bash

# ── Xinit Configuration ────────────────────────────────────────

# Load Xresources
[[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources

# Set keyboard layout
setxkbmap -layout us,ar -option grp:alt_shift_toggle

# Set keyboard repeat rate
xset r rate 300 50

# Disable bell
xset -b

# Screen timeout
xset dpms 600 600 600

# Screen blanking
xset s 600 600

# Numlock (delayed: on cold boot the X server can still be finishing
# keyboard device init here, which makes an immediate `numlockx on` a no-op)
( sleep 1; numlockx on ) &

# Qt apps: use qt5ct/qt6ct for theming (qt6ct's plugin also answers to
# the "qt5ct" key, so one variable covers both Qt5 and Qt6 apps)
export QT_QPA_PLATFORMTHEME=qt5ct

# Source profile
[[ -f ~/.profile ]] && . ~/.profile

# Start i3
exec i3 -c ~/.config/i3/config
