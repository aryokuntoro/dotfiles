#!/usr/bin/env bash

# ── Xinit Configuration ────────────────────────────────────────

# Load Xresources
[[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources

# Set keyboard layout
setxkbmap -layout us,ar -option grp:alt_shift_toggle

# Set keyboard repeat rate
xset r rate 300 50

# Disable bell
xset -b

# Screen timeout/DPMS, xss-lock, numlockx retry, and the HDMI color
# range fix used to live here, but ly can launch i3 straight from
# /usr/share/xsessions/i3.desktop without ever sourcing this file --
# they now live in config/autostart/autostart.sh, which runs via i3's
# exec_always regardless of which session entry was picked at login.

# Qt apps: use qt5ct/qt6ct for theming (qt6ct's plugin also answers to
# the "qt5ct" key, so one variable covers both Qt5 and Qt6 apps)
export QT_QPA_PLATFORMTHEME=qt5ct

# Source profile
[[ -f ~/.profile ]] && . ~/.profile

# Start i3
exec i3 -c ~/.config/i3/config
