! ── URxvt ──────────────────────────────────────────────────────
URxvt.font: xft:JetBrainsMono Nerd Font:size=12
URxvt.letterSpace: 0
URxvt.lineSpace: 0
URxvt.geometry: 90x24
URxvt.scrollBar: false
URxvt.scrollBar_right: false
URxvt.scrollBar_floating: false
URxvt.scrollstyle: rxvt
URxvt.saveLines: 10000
URxvt.cursorBlink: true
URxvt.cursorUnderline: false
URxvt.depth: 32
URxvt.transparent: false
URxvt.shading: 0
URxvt.fading: 0
URxvt.perl-ext-common: default,clipboard,selection
URxvt.clipboard.autocopy: true
URxvt.clipboard.cmd: xclip -selection clipboard
URxvt.keysym.C-c: perl:clipboard:copy
URxvt.keysym.C-v: perl:clipboard:paste
URxvt.keysym.C-S-V: perl:clipboard:paste

! ── Xcursor ────────────────────────────────────────────────────
Xcursor.theme: Bibata-Modern-Classic
Xcursor.size: 24

! ── Xft ────────────────────────────────────────────────────────
Xft.dpi: 96
Xft.antialias: true
Xft.hinting: true
! rgba: none, not rgb -- HDMI-0 here is a TV; its subpixel layout and
! internal scaling do not reliably match the RGB-stripe assumption
! subpixel hinting depends on, so it was showing color fringing on
! small text. Plain grayscale antialiasing avoids that.
Xft.rgba: none
Xft.autohint: false
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault

! ── Emacs ──────────────────────────────────────────────────────
Emacs.font: JetBrainsMono Nerd Font 12
