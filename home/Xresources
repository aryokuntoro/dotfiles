! ── Xresources ────────────────────────────────────────────────
! Colors set by apply-theme-colors.sh from the active rofi .rasi theme
! COLORS-START
*.background:  #282828
*.foreground:  #ebdbb2
*.cursorColor: #ebdbb2
*.color0:      #282828
*.color8:      #1d2021
*.color1:      #fb4934
*.color9:      #fb4934
*.color2:      #b8bb26
*.color10:     #b8bb26
*.color3:      #fabd2f
*.color11:     #fabd2f
*.color4:      #83a598
*.color12:     #83a598
*.color5:      #d3869b
*.color13:     #d3869b
*.color6:      #8ec07c
*.color14:     #8ec07c
